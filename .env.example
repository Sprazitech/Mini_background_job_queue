# Supabase. Replace placeholders locally; never put live credentials in this file.
# Use the connection string copied from Supabase Connect (Session pooler for IPv4).
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:URL_ENCODED_PASSWORD@your-pooler-host:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co

# Backend-only key. The current seed script expects this legacy variable name.
# Do not put a real key here. See scripts/seed.py before switching to a new sb_secret key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# API security (use DIFFERENT values for local vs prod)
API_KEY=dev-key-change-me

# Worker config
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
MAX_RETRIES=3

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# SMTP-compatible email provider (server-side only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=jobs@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
